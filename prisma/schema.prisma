generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  Efectivo
  Debito
  Credito
  Transferencia
  Mercado_Pago
  Debito_Flora
  Debito_Diego
  Transf_Flora
  Transf_Diego
  Transf_Florencia
}

enum OrderStatus {
  PENDING
  SOLD
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  salesCreated Sale[]   @relation("SaleCreatedBy")
  ordersCreated Order[] @relation("OrderCreatedBy")
  expensesCreated Expense[] @relation("ExpenseCreatedBy")
  cashMovementsCreated CashMovement[] @relation("CashMovementCreatedBy")
  cashClosuresCreated CashClosure[] @relation("CashClosureCreatedBy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Branch {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  stockItems StockItem[]
  sales      Sale[]
  orders     Order[]
  expenses   Expense[]
  cashMovements CashMovement[]
  cashClosures CashClosure[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model ProductCategory {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  products  StockItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model StockItem {
  id        Int        @id @default(autoincrement())
  name      String
  category  String
  categoryId Int?
  categoryRef ProductCategory? @relation(fields: [categoryId], references: [id])
  branchId  Int
  branch    Branch     @relation(fields: [branchId], references: [id])
  units     Int
  price     Float
  costPrice  Float?
  finalPrice Float?
  saleItems SaleItem[]
  orderItems OrderItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([branchId])
  @@index([categoryId])
  @@index([name])
}

model Sale {
  id            Int           @id @default(autoincrement())
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  createdByUserId Int?
  createdBy       User?       @relation("SaleCreatedBy", fields: [createdByUserId], references: [id])
  customer      String        @default("Consumidor final")
  amount        Float
  paymentMethod PaymentMethod
  items         SaleItem[]
  sourceOrderId Int?          @unique
  sourceOrder   Order?        @relation(fields: [sourceOrderId], references: [id])
  cashMovement  CashMovement?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([branchId])
  @@index([createdByUserId])
  @@index([paymentMethod])
  @@index([createdAt])
}

model SaleItem {
  id          Int       @id @default(autoincrement())
  saleId      Int
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockItemId Int
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  name        String
  units       Int
  unitPrice   Float
  subtotal    Float

  @@index([saleId])
  @@index([stockItemId])
}

model Order {
  id        Int         @id @default(autoincrement())
  branchId  Int
  branch    Branch      @relation(fields: [branchId], references: [id])
  createdByUserId Int?
  createdBy       User?       @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  customer  String
  phone     String?
  detail    String
  amount    Float
  deposit   Float?
  depositPaymentMethod PaymentMethod?
  dueDate   DateTime
  status    OrderStatus @default(PENDING)
  items     OrderItem[]
  sale      Sale?
  depositCashMovement CashMovement?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([branchId])
  @@index([createdByUserId])
  @@index([status])
  @@index([dueDate])
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItemId Int
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  name        String
  units       Int
  unitPrice   Float
  subtotal    Float

  @@index([orderId])
  @@index([stockItemId])
}

model Expense {
  id              Int      @id @default(autoincrement())
  branchId        Int?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  createdByUserId Int?
  createdBy       User?    @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  name            String
  description     String?
  invoiceType     String?
  amount          Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId])
  @@index([createdByUserId])
  @@index([createdAt])
}

model CashMovement {
  id              Int            @id @default(autoincrement())
  branchId        Int
  branch          Branch         @relation(fields: [branchId], references: [id])
  createdByUserId Int?
  createdBy       User?          @relation("CashMovementCreatedBy", fields: [createdByUserId], references: [id])
  type            String
  source          String
  description     String?
  amount          Float
  paymentMethod   PaymentMethod?
  orderId         Int?           @unique
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  saleId          Int?           @unique
  sale            Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  occurredAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([branchId])
  @@index([createdByUserId])
  @@index([type])
  @@index([source])
  @@index([occurredAt])
}

model CashClosure {
  id              Int      @id @default(autoincrement())
  branchId        Int
  branch          Branch   @relation(fields: [branchId], references: [id])
  createdByUserId Int?
  createdBy       User?    @relation("CashClosureCreatedBy", fields: [createdByUserId], references: [id])
  date            DateTime
  amount          Float
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([branchId, date])
  @@index([branchId])
  @@index([createdByUserId])
  @@index([date])
}
